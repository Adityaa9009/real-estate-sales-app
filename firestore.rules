rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmployeeDoc() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function myRole() {
      return myEmployeeDoc().data.role;
    }

    function isActiveEmployee() {
      return isSignedIn() && myEmployeeDoc().data.active == true;
    }

    function isAdmin() {
      return isActiveEmployee() && myRole() == 'admin';
    }

    function isExecutive() {
      return isActiveEmployee() && myRole() == 'executive';
    }

    function isAdminOrExecutive() {
      return isAdmin() || isExecutive();
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn() && (request.auth.uid == employeeId || isAdmin());
      allow create, update: if isAdminOrExecutive();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isActiveEmployee() && (
        isAdminOrExecutive() ||
        resource.data.assignedInsideSalesId == request.auth.uid ||
        resource.data.assignedOutsideSalesId == request.auth.uid
      );
      allow create: if isAdminOrExecutive();
      allow update: if isActiveEmployee() && (
        isAdminOrExecutive() ||
        resource.data.assignedInsideSalesId == request.auth.uid ||
        resource.data.assignedOutsideSalesId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isActiveEmployee() && resource.data.employeeId == request.auth.uid);
      allow create: if isActiveEmployee() && request.resource.data.employeeId == request.auth.uid;
      allow update: if isAdmin() || (isActiveEmployee() && resource.data.employeeId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /customer_assignments/{assignmentId} {
      allow read: if isActiveEmployee() && (
        isAdminOrExecutive() ||
        resource.data.insideSalesId == request.auth.uid ||
        resource.data.outsideSalesId == request.auth.uid
      );
      allow create: if isAdminOrExecutive();
      allow update: if isActiveEmployee() && (
        isAdminOrExecutive() ||
        resource.data.insideSalesId == request.auth.uid ||
        resource.data.outsideSalesId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /call_updates/{callUpdateId} {
      allow read: if isAdminOrExecutive() || (isActiveEmployee() && resource.data.insideSalesId == request.auth.uid);
      allow create: if isActiveEmployee() && request.resource.data.insideSalesId == request.auth.uid;
      allow update: if isAdmin() || (isActiveEmployee() && resource.data.insideSalesId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if isAdmin() || (isActiveEmployee() && resource.data.outsideSalesId == request.auth.uid);
      allow create: if isActiveEmployee() && request.resource.data.outsideSalesId == request.auth.uid;
      allow update: if isAdmin() || (isActiveEmployee() && resource.data.outsideSalesId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /broadcast_messages/{messageId} {
      allow read: if isActiveEmployee() && myRole() in resource.data.targetRoles;
      allow create, update, delete: if isAdmin();
    }
  }
}
